// Cloudflare Workers config: https://developers.cloudflare.com/workers/wrangler/configuration/
// Deploy from this folder: npx wrangler deploy     Local test: npx wrangler dev
{
  "name": "nokhtebazi",
  "main": "worker.js",
  "compatibility_date": "2026-08-15",

  // public/ is served straight from Cloudflare's edge; only /api/* runs the Worker.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // One Room per game table. SQLite-backed so it runs on the free plan.
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] }
  ],

  // Cloudflare creates the DNS record and certificate for this hostname on deploy.
  "routes": [
    { "pattern": "nokhtebazi.vortal.space", "custom_domain": true }
  ],

  "observability": { "enabled": true }
}
