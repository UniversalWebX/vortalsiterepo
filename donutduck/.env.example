# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token

# No API key needed — data is scraped from donutstats.org.

# Optional: a server ID for instant slash-command sync while developing.
# Leave blank for global commands (can take up to an hour to appear).
GUILD_ID=

# Optional: Twitch live notifications. Create an app (free) at
# https://dev.twitch.tv/console/apps — set the OAuth redirect to
# http://localhost and copy the Client ID and secret here.
# Leave blank to disable /twitch.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ---- Web dashboard (optional) ----
# From the same Discord application as the bot: OAuth2 tab.
# Add DASHBOARD_BASE_URL + /callback as an OAuth2 redirect there.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# The public address people visit, e.g. https://yourname.mooo.com
DASHBOARD_BASE_URL=
DASHBOARD_PORT=8080
# Random string used to sign login cookies. Generate with:
#   python -c "import secrets;print(secrets.token_hex(32))"
DASHBOARD_SECRET=

# ---- FreeDNS dynamic DNS (optional) ----
# "Direct URL" for your subdomain at https://freedns.afraid.org/dynamic/
# This is a credential — keep it out of any repo.
FREEDNS_UPDATE_URL=

# Optional: where the SQLite file lives (trackers, tickets, giveaways, config).
DB_PATH=donutduck.db
